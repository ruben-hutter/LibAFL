# Default recipe, runs when you just type `just`
default: list

# List all available commands
list:
    @just --list

# Build both projects (release mode by default)
build: build-release

# Build both projects in release mode
build-release: build-runtime-release build-fuzzer-release

# Build both projects in debug mode
build-dev: build-runtime-dev build-fuzzer-dev

# Test both projects
test: test-runtime test-fuzzer

# Clean both projects
clean: clean-runtime clean-fuzzer

# Clean fuzzer artifacts (corpus, crashes, etc)
clean-artifacts:
    @echo "Cleaning fuzzer artifacts..."
    @cd fuzzer && bash scripts/clean.sh
    @echo "Cleanup complete!"

# Full clean (cargo clean + artifacts)
clean-all: clean clean-artifacts

# --- Runtime Project ---

# Build the runtime project (release mode)
build-runtime: build-runtime-release

# Build the runtime project in release mode
build-runtime-release:
    @echo "Building the runtime project (release)..."
    @cargo build --release --manifest-path runtime/Cargo.toml
    @echo "Build complete!"

# Build the runtime project in debug mode
build-runtime-dev:
    @echo "Building the runtime project (debug)..."
    @cargo build --manifest-path runtime/Cargo.toml
    @echo "Build complete!"

# Test the runtime project (depends on it being built first)
test-runtime: build-runtime-release
    @echo "Running runtime tests..."
    @cargo test --manifest-path runtime/Cargo.toml

# Clean the runtime project
clean-runtime:
    @echo "Cleaning runtime project..."
    @cargo clean --manifest-path runtime/Cargo.toml
    @echo "Cleanup complete!"


# --- Fuzzer Project ---

# Build the fuzzer project (release mode)
build-fuzzer: build-fuzzer-release

# Build the fuzzer project in release mode
build-fuzzer-release:
    @echo "Building the fuzzer project (release)..."
    @cargo build --release --manifest-path fuzzer/Cargo.toml
    @echo "Build complete!"

# Build the fuzzer project in debug mode
build-fuzzer-dev:
    @echo "Building the fuzzer project (debug)..."
    @cargo build --manifest-path fuzzer/Cargo.toml
    @echo "Build complete!"

# Test the fuzzer project (depends on it being built first)
test-fuzzer: build-fuzzer-release
    @echo "Running fuzzer tests..."
    @cargo test --manifest-path fuzzer/Cargo.toml

# Clean the fuzzer project
clean-fuzzer:
    @echo "Cleaning fuzzer project..."
    @cargo clean --manifest-path fuzzer/Cargo.toml

# --- Running the Fuzzer ---

# Run the fuzzer in release mode (args: num_regular num_concolic [mode])
# Modes: forkserver (default), snapshot, separate, symcc
run num_regular="2" num_concolic="1" mode="forkserver": build-release
    @cd fuzzer && FUZZER_MODE=release bash scripts/run_fuzzing.sh {{num_regular}} {{num_concolic}} {{mode}}

# Run the fuzzer in debug mode (args: num_regular num_concolic [mode])
run-dev num_regular="2" num_concolic="1" mode="forkserver": build-dev
    @cd fuzzer && FUZZER_MODE=debug bash scripts/run_fuzzing.sh {{num_regular}} {{num_concolic}} {{mode}}

# Shortcut: snapshot concolic mode only (args: num_regular num_concolic [target_function])
# In-process SymQEMU snapshot execution over the hybrid QEMU tree.
# Kills any previous fuzzing session/processes first, rebuilds with the
# qemu-snapshot feature, then creates the tmux session like `run`.
# Requires qemu-hybrid/ to be built (see snapshot_runner/env.sh + MILESTONE_PLAN.md).
#
# target_function: optional guest function where the snapshot is taken and
#   symbolic execution starts (set via the SNAPSHOT_TARGET_FUNCTION env var,
#   resolved as an ELF symbol; defaults to LLVMFuzzerTestOneInput).
#   Example: just run-snapshot 0 1 foo
run-snapshot num_regular="0" num_concolic="1" target_function="":
    #!/usr/bin/env bash
    set -e
    tmux kill-session -t libafl_fuzz 2>/dev/null || true
    pkill -9 -f 'target/release/libfuzzer_simple_[c]oncolic' 2>/dev/null || true
    sleep 1
    source snapshot_runner/env.sh
    cd fuzzer
    cargo build --release --features qemu-snapshot
    # A plain (non-feature) build re-copies OLD standalone-mode shims into
    # fuzzer/; they would shadow the fresh hybrid shim via LD_LIBRARY_PATH.
    rm -f libSymCCRtShared.so libSymRuntime.so
    if [ -n "{{target_function}}" ]; then
        export SNAPSHOT_TARGET_FUNCTION="{{target_function}}"
        echo "Snapshot entry point: {{target_function}}"
    fi
    FUZZER_MODE=release SKIP_BUILD=1 bash scripts/run_fuzzing.sh {{num_regular}} {{num_concolic}} snapshot

# Kill the fuzzing tmux session and all fuzzer processes (clean restart helper)
kill-fuzz:
    tmux kill-session -t libafl_fuzz 2>/dev/null || true
    pkill -9 -f 'target/release/libfuzzer_simple_[c]oncolic' 2>/dev/null || true
    @echo "Fuzzing session and processes killed."
